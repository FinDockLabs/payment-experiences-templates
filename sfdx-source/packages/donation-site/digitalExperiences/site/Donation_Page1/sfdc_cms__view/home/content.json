                "maxContentWidth": "",
                "sectionColumnGutterWidth": "",
                "sectionConfig": "{\"UUID\": \"423e57d9-c264-47b7-97c2-9e88e85e87f0\", \"columns\": [{\"UUID\": \"f02a5634-cbbd-471a-980b-b8fb50c5796f\", \"columnName\": \"Column 1\", \"columnKey\": \"col1\", \"columnWidth\": \"12\", \"seedComponents\": []}]}",
