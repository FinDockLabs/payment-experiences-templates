                    {
                      "attributes": {
                        "dxpStyle": {},
                        "imageInfos": "",
                        "richTextValue": "<div class=\"cgt-faq-inner\" id=\"faq\"><h2>Questions about giving</h2><details open><summary>Can I change or stop my monthly gift?</summary><p>Yes, at any time. Email us or use the link in your confirmation email.</p></details><details><summary>Is my donation tax-deductible?</summary><p>[Tax status and registration details.]</p></details><details><summary>How is my payment handled?</summary><p>Payments are encrypted and processed by FinDock in our Salesforce. We never see or store your card details.</p></details></div>"
                      },
