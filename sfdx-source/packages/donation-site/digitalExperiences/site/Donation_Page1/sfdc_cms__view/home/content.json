                "sectionConfig": "{\"UUID\": \"815f34d1-3886-44e0-823b-fa4ec6826a7d\", \"columns\": [{\"UUID\": \"da30fa55-5157-4390-952d-a108cbd99787\", \"columnName\": \"Column 1\", \"columnKey\": \"col1\", \"columnWidth\": \"12\", \"seedComponents\": []}]}",
