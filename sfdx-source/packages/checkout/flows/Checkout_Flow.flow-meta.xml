<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <actionCalls>
        <description>Gets the payer&apos;s browser, operating system, device and locale and stores them in userAgentInfo. Values are empty if the browser doesn&apos;t provide them.</description>
        <name>Get_User_Agent_Info</name>
        <label>Get User Agent Info</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <actionName>c:getUserAgentInfo</actionName>
        <actionType>lwcComponent</actionType>
        <connector>
            <targetReference>Get_Order_Details</targetReference>
        </connector>
        <flowTransactionModel>CurrentTransaction</flowTransactionModel>
        <nameSegment>c:getUserAgentInfo</nameSegment>
        <offset>0</offset>
        <outputParameters>
            <assignToReference>userAgentInfo</assignToReference>
            <name>userAgentInfo</name>
        </outputParameters>
    </actionCalls>
    <apiVersion>68.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <assignments>
        <description>PLACEHOLDER. Replace this element with a Get Records element that reads the order to pay (for example the standard Order object, an Opportunity or your own object, using the id input variable), then set amount, currency, reference, frequency and the payer&apos;s Contact fields from that record, and the order lines in the Pay screen&apos;s order summary. Until then the checkout shows these example values.</description>
        <name>Get_Order_Details</name>
        <label>Placeholder: get order details</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>amount</assignToReference>
            <operator>Assign</operator>
            <value>
                <numberValue>167.0</numberValue>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>currency</assignToReference>
            <operator>Assign</operator>
            <value>
                <stringValue>EUR</stringValue>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>reference</assignToReference>
            <operator>Assign</operator>
            <value>
                <stringValue>INV-012345</stringValue>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>frequency</assignToReference>
            <operator>Assign</operator>
            <value>
                <stringValue>oneTime</stringValue>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>Contact.FirstName</assignToReference>
            <operator>Assign</operator>
            <value>
                <stringValue>John</stringValue>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>Contact.LastName</assignToReference>
            <operator>Assign</operator>
            <value>
                <stringValue>Johnson</stringValue>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>Contact.Email</assignToReference>
            <operator>Assign</operator>
            <value>
                <stringValue>john@example.com</stringValue>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Pay_Screen</targetReference>
        </connector>
    </assignments>
    <customProperties>
        <name>ScreenProgressIndicator</name>
        <value>
            <stringValue>{&quot;location&quot;:&quot;top&quot;,&quot;type&quot;:&quot;simple&quot;}</stringValue>
        </value>
    </customProperties>
    <environments>Default</environments>
    <formulas>
        <description>Where the payer goes after a successful payment: the successUrl input if the page passes one (the Lightning Out examples do), else https://www.example.com/success. Replace the example URL with your own page.</description>
        <name>Success_URL</name>
        <dataType>String</dataType>
        <expression>BLANKVALUE({!successUrl}, &quot;https://www.example.com/success&quot;)</expression>
    </formulas>
    <formulas>
        <description>Where the payer goes after a failed or cancelled payment: the failureUrl input if the page passes one (the Lightning Out examples do), else https://www.example.com/failure. Replace the example URL with your own page.</description>
        <name>Failure_URL</name>
        <dataType>String</dataType>
        <expression>BLANKVALUE({!failureUrl}, &quot;https://www.example.com/failure&quot;)</expression>
    </formulas>
    <formulas>
        <description>The amount with its currency symbol, e.g. €167.00, for the order summary.</description>
        <name>Amount_Display</name>
        <dataType>String</dataType>
        <expression>CASE({!currency},&quot;EUR&quot;,&quot;€&quot;,&quot;USD&quot;,&quot;$&quot;,&quot;GBP&quot;,&quot;£&quot;,{!currency} &amp; &quot; &quot;) &amp; IF(FLOOR(BLANKVALUE({!amount}, 0)) >= 1000, TEXT(FLOOR(FLOOR(BLANKVALUE({!amount}, 0))/1000)) &amp; &quot;,&quot; &amp; RIGHT(&quot;00&quot; &amp; TEXT(MOD(FLOOR(BLANKVALUE({!amount}, 0)),1000)),3), TEXT(FLOOR(BLANKVALUE({!amount}, 0)))) &amp; &quot;.&quot; &amp; RIGHT(&quot;0&quot; &amp; TEXT(ROUND(MOD(BLANKVALUE({!amount}, 0)*100,100),0)),2)</expression>
    </formulas>
    <formulas>
        <name>Frequency_Display_Text</name>
        <dataType>String</dataType>
        <expression>if({!frequency}=&apos;oneTime&apos;, $Label.ec_frequency_label_one_time, $Label.ec_frequency_label_monthly)</expression>
    </formulas>
    <formulas>
        <name>Is_Current_User_Sys_Admin</name>
        <dataType>Boolean</dataType>
        <expression>{!$Profile.Name} = &apos;System Administrator&apos;</expression>
    </formulas>
    <formulas>
        <name>One_Time_Amount</name>
        <dataType>Currency</dataType>
        <expression>IF({!frequency} = &apos;oneTime&apos;, {!amount}, null)</expression>
        <scale>2</scale>
    </formulas>
    <formulas>
        <name>Recurring_Amount</name>
        <dataType>Currency</dataType>
        <expression>IF({!frequency} = &apos;recurring&apos;, {!amount}, null)</expression>
        <scale>2</scale>
    </formulas>
