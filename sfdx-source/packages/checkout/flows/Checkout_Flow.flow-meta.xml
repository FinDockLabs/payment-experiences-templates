    <formulas>
        <description>The amount with its currency symbol, e.g. €167.00, for the order summary.</description>
        <name>Amount_Display</name>
        <dataType>String</dataType>
        <expression>CASE({!currency},&quot;EUR&quot;,&quot;€&quot;,&quot;USD&quot;,&quot;$&quot;,&quot;GBP&quot;,&quot;£&quot;,{!currency} &amp; &quot; &quot;) &amp; IF(FLOOR(BLANKVALUE({!amount}, 0)) >= 1000, TEXT(FLOOR(FLOOR(BLANKVALUE({!amount}, 0))/1000)) &amp; &quot;,&quot; &amp; RIGHT(&quot;00&quot; &amp; TEXT(MOD(FLOOR(BLANKVALUE({!amount}, 0)),1000)),3), TEXT(FLOOR(BLANKVALUE({!amount}, 0)))) &amp; &quot;.&quot; &amp; RIGHT(&quot;0&quot; &amp; TEXT(ROUND(MOD(BLANKVALUE({!amount}, 0)*100,100),0)),2)</expression>
    </formulas>
    <formulas>
        <description>The existing record's open amount with its currency symbol.</description>
        <name>Amount_Display_Existing</name>
        <dataType>String</dataType>
        <expression>CASE(IF(ISBLANK({!Get_Installment.Id}), TEXT({!Get_Recurring_Payment.CurrencyIsoCode}), TEXT({!Get_Installment.CurrencyIsoCode})),&quot;EUR&quot;,&quot;€&quot;,&quot;USD&quot;,&quot;$&quot;,&quot;GBP&quot;,&quot;£&quot;,IF(ISBLANK({!Get_Installment.Id}), TEXT({!Get_Recurring_Payment.CurrencyIsoCode}), TEXT({!Get_Installment.CurrencyIsoCode})) &amp; &quot; &quot;) &amp; IF(FLOOR(BLANKVALUE(IF(ISBLANK({!Get_Installment.Id}), {!Get_Recurring_Payment.cpm__Amount__c}, {!Get_Installment.cpm__Amount_Open__c}), 0)) >= 1000, TEXT(FLOOR(FLOOR(BLANKVALUE(IF(ISBLANK({!Get_Installment.Id}), {!Get_Recurring_Payment.cpm__Amount__c}, {!Get_Installment.cpm__Amount_Open__c}), 0))/1000)) &amp; &quot;,&quot; &amp; RIGHT(&quot;00&quot; &amp; TEXT(MOD(FLOOR(BLANKVALUE(IF(ISBLANK({!Get_Installment.Id}), {!Get_Recurring_Payment.cpm__Amount__c}, {!Get_Installment.cpm__Amount_Open__c}), 0)),1000)),3), TEXT(FLOOR(BLANKVALUE(IF(ISBLANK({!Get_Installment.Id}), {!Get_Recurring_Payment.cpm__Amount__c}, {!Get_Installment.cpm__Amount_Open__c}), 0)))) &amp; &quot;.&quot; &amp; RIGHT(&quot;0&quot; &amp; TEXT(ROUND(MOD(BLANKVALUE(IF(ISBLANK({!Get_Installment.Id}), {!Get_Recurring_Payment.cpm__Amount__c}, {!Get_Installment.cpm__Amount_Open__c}), 0)*100,100),0)),2)</expression>
    </formulas>
    <formulas>
        <description>Order line for an existing record: its bank statement description, or its reference.</description>
        <name>Description_Existing</name>
        <dataType>String</dataType>
        <expression>BLANKVALUE(IF(ISBLANK({!Get_Installment.Id}), {!Get_Recurring_Payment.cpm__Bank_Statement_Description__c}, {!Get_Installment.cpm__Bank_Statement_Description__c}), {!Reference_Existing})</expression>
    </formulas>
    <formulas>
        <name>Frequency_Display_Text</name>
        <dataType>String</dataType>
        <expression>if({!frequency}=&apos;oneTime&apos;, $Label.ec_frequency_label_one_time, $Label.ec_frequency_label_monthly)</expression>
    </formulas>
    <formulas>
        <name>Frequency_Display_Text_Existing</name>
        <dataType>String</dataType>
